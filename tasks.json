{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LunaSight UI",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "lunasight-vite",
        "pattern": [
          {
            "regexp": "^(.*):(\\d+):(\\d+):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v[0-9].*",
          "endsPattern": "Local:.*"
        }
      }
    },
    {
      "label": "LunaSight: Start",
      "dependsOn": ["LunaSight UI"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
